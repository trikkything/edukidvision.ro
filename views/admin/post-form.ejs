<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= post ? 'Editează articol' : 'Articol nou' %> — EduKid Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>" />
  <!-- Quill rich text editor -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet" />
  <style>
    .ql-container { font-family: var(--ff); font-size: 0.95rem; min-height: 280px; }
    .ql-toolbar { border-color: var(--border) !important; background: var(--bg); }
    .ql-container.ql-snow { border-color: var(--border) !important; }
    .ql-container.ql-snow:focus-within { border-color: var(--teal) !important; }
    /* Video block inside the editor — mirrors the public site styles */
    .ql-editor .video-embed { width: 100%; margin: 1.25rem auto; cursor: pointer; position: relative; outline: 2px solid transparent; outline-offset: 3px; transition: outline-color .15s; }
    .ql-editor .video-embed:hover { outline-color: var(--teal); }
    .ql-editor .video-embed[data-size="large"]  { width: 75%; }
    .ql-editor .video-embed[data-size="medium"] { width: 50%; }
    .ql-editor .video-embed[data-align="left"]  { margin-left: 0; margin-right: auto; }
    .ql-editor .video-embed[data-align="right"] { margin-left: auto; margin-right: 0; }
    .ql-editor .video-embed[data-ratio="9-16"]  { max-width: 300px; }
    .ql-editor .video-embed__frame { position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000; }
    .ql-editor .video-embed[data-ratio="4-3"]  .video-embed__frame { aspect-ratio: 4 / 3; }
    .ql-editor .video-embed[data-ratio="9-16"] .video-embed__frame { aspect-ratio: 9 / 16; }
    .ql-editor .video-embed__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; pointer-events: none; }
    .ql-editor .video-embed__caption { margin-top: 0.5rem; font-size: 0.82rem; color: var(--ink-muted); text-align: center; }
    .ql-editor .video-embed::after { content: '⚙ Setări video'; position: absolute; top: 8px; right: 8px; padding: 0.3rem 0.6rem; font-size: 0.72rem; font-weight: 600; background: var(--teal); color: #fff; opacity: 0; transition: opacity .15s; }
    .ql-editor .video-embed:hover::after { opacity: 1; }

    /* Video settings dialog */
    .vmodal { position: fixed; inset: 0; z-index: 1000; background: rgba(0,0,0,.45); display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .vmodal[hidden] { display: none; }
    .vmodal-box { background: var(--white); width: 100%; max-width: 560px; max-height: calc(100vh - 2rem); overflow-y: auto; padding: 1.5rem; box-shadow: 0 20px 60px rgba(0,0,0,.25); }
    .vmodal-title { font-family: var(--ff-display); font-size: 1.15rem; font-weight: 600; margin: 0 0 1rem; }
    .vmodal-box input[type="text"], .vmodal-box select { width: 100%; }
    .vmodal-error { color: var(--danger); font-size: 0.8rem; min-height: 1.1em; margin: 0.35rem 0 0.5rem; }
    .vmodal-preview { display: none; margin-bottom: 1rem; align-items: center; gap: 0.75rem; }
    .vmodal-preview.is-visible { display: flex; }
    .vmodal-preview img { width: 120px; aspect-ratio: 16 / 9; object-fit: cover; background: #000; }
    .vmodal-preview span { font-size: 0.78rem; color: var(--ink-faint); word-break: break-all; }
    .vmodal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
    .vmodal-grid .full { grid-column: 1 / -1; }
    .vmodal-actions { display: flex; gap: 0.5rem; justify-content: flex-end; margin-top: 1.25rem; flex-wrap: wrap; }
    .vmodal-actions .admin-btn--danger { margin-right: auto; }
    @media (max-width: 520px) { .vmodal-grid { grid-template-columns: 1fr; } }
    .cover-preview { max-width: 100%; max-height: 200px; object-fit: cover; border: 1px solid var(--border); margin-top: 0.5rem; display: none; }
    .cover-preview.is-visible { display: block; }
    .cover-tabs { display: flex; gap: 0; margin-bottom: 0.75rem; }
    .cover-tab { padding: 0.4rem 0.9rem; font-size: 0.78rem; font-weight: 600; border: 1px solid var(--border); background: var(--bg); color: var(--ink-muted); cursor: pointer; }
    .cover-tab:first-child { border-right: none; }
    .cover-tab.is-active { background: var(--white); color: var(--ink); border-bottom-color: var(--white); }
    .cover-tab-panel { display: none; }
    .cover-tab-panel.is-active { display: block; }
    .upload-btn-wrap { display: flex; gap: 0.5rem; align-items: center; }
    .upload-status { font-size: 0.78rem; color: var(--ink-faint); }
  </style>
</head>
<body class="admin-page">

  <aside class="admin-sidebar">
    <a href="/admin" class="admin-brand">
      <img src="/images/logo-mark-400.png" alt="" class="admin-brand-logo" />
      <div>
        <div class="admin-brand-name"><span style="color:#7CBB6A">EduKid</span><span style="color:#009B9E"> Vision</span></div>
        <div class="admin-brand-sub">Admin</div>
      </div>
    </a>
    <nav class="admin-nav">
      <a href="/admin" class="admin-nav-link">Cursuri</a>
      <a href="/admin/posts" class="admin-nav-link is-active">Articole</a>
      <a href="/admin/images" class="admin-nav-link">Imagini</a>
      <a href="/" class="admin-nav-link" target="_blank">Vezi site ↗</a>
    </nav>
    <form method="POST" action="/admin/logout" class="admin-logout">
      <button type="submit" class="admin-nav-link admin-nav-link--logout">Ieșire</button>
    </form>
  </aside>

  <main class="admin-main">
    <div class="admin-topbar">
      <div>
        <a href="/admin/posts" class="admin-back">← Înapoi la articole</a>
        <h1 class="admin-page-title"><%= post ? 'Editează: ' + post.title : 'Articol nou' %></h1>
      </div>
    </div>

    <% if (error) { %><p class="admin-form-error"><%= error %></p><% } %>

    <form id="postForm" method="POST"
          action="<%= post ? '/admin/posts/' + post.id : '/admin/posts' %>"
          class="admin-form">

      <input type="hidden" name="content" id="f-content" value="<%= post ? post.content : '' %>" />

      <!-- Basic info -->
      <div class="admin-form-section">
        <div class="admin-form-section-header">
          <h2 class="admin-form-section-title">Informații de bază</h2>
        </div>
        <div class="admin-form-grid">
          <label class="admin-label" style="grid-column:1/-1">
            Titlu articol
            <input type="text" name="title" id="f-title" placeholder="ex: EduKid Vision deschide un nou centru" value="<%= post ? post.title : '' %>" required />
          </label>

          <% if (!post) { %>
          <label class="admin-label" style="grid-column:1/-1">
            Slug (URL)
            <input type="text" name="slug" id="f-slug" placeholder="ex: inaugurare-centru-2026" value="" />
            <span class="admin-hint">Generat automat din titlu. Folosit în: /noutati/<strong>slug</strong></span>
          </label>
          <% } %>

          <label class="admin-label">
            Categorie
            <select name="category" id="f-category">
              <% const cats = ['Noutăți', 'Evenimente', 'Sfaturi părinți', 'Educație', 'Anunțuri']; %>
              <% cats.forEach(c => { %>
              <option value="<%= c %>" <%= (post && post.category === c) ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </label>

          <label class="admin-label">
            Data publicării
            <input type="date" name="publishDate" id="f-date" value="<%= post ? post.publishDate : new Date().toISOString().split('T')[0] %>" />
          </label>

          <label class="admin-label" style="grid-column:1/-1">
            Rezumat (excerpt)
            <textarea name="excerpt" id="f-excerpt" rows="2" placeholder="Scurtă descriere afișată pe card și în meta description..."><%= post ? post.excerpt : '' %></textarea>
          </label>

          <label class="admin-label" style="grid-column:1/-1">
            <div style="display:flex;align-items:center;gap:0.65rem;cursor:pointer">
              <input type="hidden" name="featured" value="0" />
              <input type="checkbox" name="featured" id="f-featured" value="1" style="width:16px;height:16px;cursor:pointer;accent-color:var(--teal)" <%= (post && post.featured) ? 'checked' : '' %> />
              <span style="font-size:0.82rem;font-weight:600;color:var(--ink);text-transform:none;letter-spacing:0">
                ★ Promovează pe prima pagină
              </span>
            </div>
            <span class="admin-hint" style="margin-top:0.25rem">Articolele promovate apar primele în secțiunea de noutăți. Maxim 3 simultan.</span>
          </label>
        </div>
      </div>

      <!-- Cover image -->
      <div class="admin-form-section">
        <div class="admin-form-section-header">
          <h2 class="admin-form-section-title">Imagine de copertă</h2>
        </div>
        <div style="padding:1.25rem">
          <div class="cover-tabs">
            <button type="button" class="cover-tab is-active" onclick="switchCoverTab('upload', this)">Încarcă fișier</button>
            <button type="button" class="cover-tab" onclick="switchCoverTab('url', this)">URL extern</button>
          </div>

          <div id="cover-panel-upload" class="cover-tab-panel is-active">
            <div class="upload-btn-wrap">
              <label for="f-image-file" class="admin-btn admin-btn--sm" style="cursor:pointer;display:inline-flex;align-items:center">Alege imagine</label>
              <input type="file" id="f-image-file" accept="image/jpeg,image/png,image/webp" style="display:none" />
              <span class="upload-status" id="upload-status">Niciun fișier ales</span>
            </div>
          </div>

          <div id="cover-panel-url" class="cover-tab-panel">
            <input type="text" id="f-image-url" placeholder="https://example.com/imagine.jpg" style="width:100%" value="" />
            <button type="button" class="admin-btn admin-btn--sm" style="margin-top:0.5rem" onclick="applyImageUrl()">Aplică URL</button>
          </div>

          <input type="hidden" name="coverImage" id="f-coverImage" value="<%= post ? post.coverImage : '' %>" />
          <% if (post && post.coverImage) { %>
          <img src="<%= post.coverImage %>" alt="" class="cover-preview is-visible" id="cover-preview" />
          <% } else { %>
          <img src="" alt="" class="cover-preview" id="cover-preview" />
          <% } %>
        </div>
      </div>

      <!-- Content (Quill) -->
      <div class="admin-form-section">
        <div class="admin-form-section-header">
          <h2 class="admin-form-section-title">Conținut articol</h2>
        </div>
        <div style="padding:0">
          <div id="quill-editor"></div>
        </div>
      </div>

      <!-- Gallery images (max 3) -->
      <div class="admin-form-section">
        <div class="admin-form-section-header">
          <h2 class="admin-form-section-title">Galerie imagini <span style="font-weight:400;color:var(--ink-faint);font-size:0.82rem">(max. 3)</span></h2>
        </div>
        <div style="padding:1.25rem">
          <p class="admin-hint" style="margin-bottom:1.25rem">Imaginile din galerie apar sub textul articolului. Fiecare imagine poate fi mărită cu click.</p>
          <div class="gallery-slots">
            <% for (let i = 0; i < 3; i++) { %>
            <% const gVal = (post && post.gallery && post.gallery[i]) ? post.gallery[i] : ''; %>
            <div class="gallery-slot" id="gslot-<%= i %>">
              <div class="gallery-slot-preview">
                <img src="<%= gVal %>" alt="" class="gallery-slot-thumb<%= gVal ? ' is-visible' : '' %>" id="gthumb-<%= i %>" />
                <span class="gallery-slot-placeholder">+ Adaugă</span>
              </div>
              <input type="hidden" name="gallery_<%= i %>" id="gval-<%= i %>" value="<%= gVal %>" />
              <input type="file" id="gfile-<%= i %>" data-slot="<%= i %>" accept="image/jpeg,image/png,image/webp" style="display:none" />
              <div class="gallery-slot-actions">
                <label for="gfile-<%= i %>" class="admin-btn admin-btn--sm" style="cursor:pointer">Alege</label>
                <button type="button" class="admin-btn admin-btn--sm admin-btn--danger" id="gremove-<%= i %>" onclick="removeGallery(<%= i %>)" style="<%= gVal ? '' : 'display:none' %>">✕</button>
              </div>
              <span class="gallery-slot-status" id="gstatus-<%= i %>"></span>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="admin-form-actions">
        <a href="/admin/posts" class="admin-btn">Anulează</a>
        <button type="submit" class="admin-btn admin-btn--primary">Salvează articolul</button>
      </div>
    </form>

    <!-- YouTube video settings dialog (insert + edit) -->
    <div class="vmodal" id="vmodal" hidden>
      <div class="vmodal-box" role="dialog" aria-modal="true" aria-labelledby="vmodal-title">
        <h3 class="vmodal-title" id="vmodal-title">Adaugă videoclip YouTube</h3>

        <label class="admin-label">
          Link YouTube
          <input type="text" id="v-url" placeholder="https://www.youtube.com/watch?v=..." autocomplete="off" />
        </label>
        <p class="vmodal-error" id="v-error"></p>

        <div class="vmodal-preview" id="v-preview">
          <img id="v-thumb" src="" alt="" />
          <span id="v-preview-text"></span>
        </div>

        <div class="vmodal-grid">
          <label class="admin-label">
            Mărime
            <select id="v-size">
              <option value="full">Lățimea articolului (100%)</option>
              <option value="large">Mare (75%)</option>
              <option value="medium">Mediu (50%)</option>
            </select>
          </label>
          <label class="admin-label">
            Aliniere
            <select id="v-align">
              <option value="center">Centru</option>
              <option value="left">Stânga</option>
              <option value="right">Dreapta</option>
            </select>
          </label>
          <label class="admin-label">
            Format
            <select id="v-ratio">
              <option value="16-9">16:9 — orizontal (standard)</option>
              <option value="4-3">4:3 — clasic</option>
              <option value="9-16">9:16 — vertical (Shorts)</option>
            </select>
          </label>
          <label class="admin-label">
            Pornește de la
            <input type="text" id="v-start" placeholder="ex: 1:30 (opțional)" autocomplete="off" />
          </label>
          <label class="admin-label full">
            Legendă (opțional)
            <input type="text" id="v-caption" placeholder="Text afișat sub videoclip" autocomplete="off" />
          </label>
        </div>
        <span class="admin-hint" style="display:block;margin-top:0.6rem">Pe telefon, videoclipul ocupă automat toată lățimea ecranului.</span>

        <div class="vmodal-actions">
          <button type="button" class="admin-btn admin-btn--danger" id="v-delete" hidden>Șterge videoclipul</button>
          <button type="button" class="admin-btn" id="v-cancel">Anulează</button>
          <button type="button" class="admin-btn admin-btn--primary" id="v-save">Inserează</button>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
  <script>
    /* ── YouTube helpers ── */
    const YT_ID = /^[A-Za-z0-9_-]{11}$/;
    const VIDEO_SIZES  = ['full', 'large', 'medium'];
    const VIDEO_ALIGNS = ['center', 'left', 'right'];
    const VIDEO_RATIOS = ['16-9', '4-3', '9-16'];

    /* Extract a YouTube video ID from any common URL form (watch, youtu.be, shorts, embed, live) */
    function youtubeId(url) {
      const s = String(url).trim();
      if (YT_ID.test(s)) return s;
      const m = s.match(
        /(?:youtube(?:-nocookie)?\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/|v\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/
      );
      return m ? m[1] : null;
    }

    /* "90", "1:30", "1:02:03", "1m30s", "90s" → seconds */
    function parseTime(t) {
      const s = String(t || '').trim().toLowerCase();
      if (!s) return 0;
      if (/^\d+$/.test(s)) return parseInt(s, 10);
      if (/^\d+(:\d{1,2}){1,2}$/.test(s)) return s.split(':').reduce((acc, n) => acc * 60 + parseInt(n, 10), 0);
      const m = s.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/);
      if (m && (m[1] || m[2] || m[3])) return (+m[1] || 0) * 3600 + (+m[2] || 0) * 60 + (+m[3] || 0);
      return NaN;
    }

    function formatTime(sec) {
      if (!sec) return '';
      const h = Math.floor(sec / 3600), m = Math.floor((sec % 3600) / 60), s = sec % 60;
      const pad = n => String(n).padStart(2, '0');
      return h ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
    }

    /* Start time embedded in a URL (?t=90, ?t=1m30s, ?start=90) */
    function urlStartTime(url) {
      const m = String(url).match(/[?&#](?:t|start)=([0-9hms:]+)/i);
      const v = m ? parseTime(m[1]) : 0;
      return Number.isFinite(v) ? v : 0;
    }

    function normalizeVideo(v) {
      v = v || {};
      return {
        id:      YT_ID.test(v.id || '') ? v.id : '',
        size:    VIDEO_SIZES.includes(v.size) ? v.size : 'full',
        align:   VIDEO_ALIGNS.includes(v.align) ? v.align : 'center',
        ratio:   VIDEO_RATIOS.includes(v.ratio) ? v.ratio : '16-9',
        start:   Math.max(0, parseInt(v.start, 10) || 0),
        caption: String(v.caption || '').trim().slice(0, 300),
      };
    }

    /* Builds <figure class="video-embed" data-…><div class="video-embed__frame"><iframe…></div><figcaption…></figure> */
    function fillVideoNode(node, value) {
      const v = normalizeVideo(value);
      node.setAttribute('contenteditable', 'false');
      node.dataset.id = v.id;
      node.dataset.size = v.size;
      node.dataset.align = v.align;
      node.dataset.ratio = v.ratio;
      node.dataset.start = String(v.start);

      const frame = document.createElement('div');
      frame.className = 'video-embed__frame';
      const iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + v.id + '?rel=0' + (v.start ? '&start=' + v.start : '');
      iframe.title = v.caption || 'Videoclip YouTube';
      iframe.setAttribute('loading', 'lazy');
      iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      frame.appendChild(iframe);
      node.appendChild(frame);

      if (v.caption) {
        const cap = document.createElement('figcaption');
        cap.className = 'video-embed__caption';
        cap.textContent = v.caption;
        node.appendChild(cap);
      }
      return node;
    }

    /* ── Custom Quill blot for the configurable YouTube block ── */
    const BlockEmbed = Quill.import('blots/block/embed');
    class YoutubeBlot extends BlockEmbed {
      static create(value) {
        return fillVideoNode(super.create(), value);
      }
      static value(node) {
        const cap = node.querySelector('figcaption');
        return normalizeVideo({
          id: node.dataset.id, size: node.dataset.size, align: node.dataset.align,
          ratio: node.dataset.ratio, start: node.dataset.start, caption: cap ? cap.textContent : '',
        });
      }
    }
    YoutubeBlot.blotName = 'youtube';
    YoutubeBlot.tagName = 'FIGURE';
    YoutubeBlot.className = 'video-embed';
    Quill.register(YoutubeBlot);

    /* Upgrade videos saved with the earlier plain embed (<iframe class="ql-video">) */
    function upgradeLegacyVideos(html) {
      if (!html.includes('ql-video')) return html;
      const tpl = document.createElement('template');
      tpl.innerHTML = html;
      tpl.content.querySelectorAll('iframe.ql-video').forEach(ifr => {
        const id = youtubeId(ifr.getAttribute('src') || '');
        if (!id) return;
        const fig = document.createElement('figure');
        fig.className = 'video-embed';
        fillVideoNode(fig, { id, start: urlStartTime(ifr.getAttribute('src') || '') });
        ifr.replaceWith(fig);
      });
      return tpl.innerHTML;
    }

    /* ── Video settings dialog ── */
    const vm = {
      root: document.getElementById('vmodal'),
      title: document.getElementById('vmodal-title'),
      url: document.getElementById('v-url'),
      error: document.getElementById('v-error'),
      preview: document.getElementById('v-preview'),
      thumb: document.getElementById('v-thumb'),
      previewText: document.getElementById('v-preview-text'),
      size: document.getElementById('v-size'),
      align: document.getElementById('v-align'),
      ratio: document.getElementById('v-ratio'),
      start: document.getElementById('v-start'),
      caption: document.getElementById('v-caption'),
      del: document.getElementById('v-delete'),
      save: document.getElementById('v-save'),
      cancel: document.getElementById('v-cancel'),
      editingBlot: null,
      insertIndex: 0,
    };

    function syncAlign() {
      vm.align.disabled = vm.size.value === 'full';
    }

    function refreshPreview() {
      const id = youtubeId(vm.url.value);
      if (id) {
        vm.thumb.src = 'https://i.ytimg.com/vi/' + id + '/mqdefault.jpg';
        vm.previewText.textContent = 'ID videoclip: ' + id;
        vm.preview.classList.add('is-visible');
        vm.error.textContent = '';
      } else {
        vm.preview.classList.remove('is-visible');
      }
      return id;
    }

    function openVideoDialog(blot) {
      vm.editingBlot = blot || null;
      const v = blot ? YoutubeBlot.value(blot.domNode) : normalizeVideo({});
      if (!blot) {
        const range = quill.getSelection(true);
        vm.insertIndex = range ? range.index : quill.getLength();
      }
      vm.title.textContent = blot ? 'Setări videoclip' : 'Adaugă videoclip YouTube';
      vm.save.textContent  = blot ? 'Salvează' : 'Inserează';
      vm.del.hidden = !blot;
      vm.url.value = v.id ? 'https://www.youtube.com/watch?v=' + v.id : '';
      vm.size.value = v.size;
      vm.align.value = v.align;
      vm.ratio.value = v.ratio;
      vm.start.value = formatTime(v.start);
      vm.caption.value = v.caption;
      vm.error.textContent = '';
      syncAlign();
      refreshPreview();
      vm.root.hidden = false;
      vm.url.focus();
      vm.url.select();
    }

    function closeVideoDialog() {
      vm.root.hidden = true;
      vm.editingBlot = null;
    }

    function saveVideoDialog() {
      const id = refreshPreview();
      if (!id) { vm.error.textContent = 'Link YouTube invalid. Exemplu: https://www.youtube.com/watch?v=XXXXXXXXXXX'; vm.url.focus(); return; }
      const start = parseTime(vm.start.value);
      if (!Number.isFinite(start)) { vm.error.textContent = 'Momentul de start nu e valid. Folosește ex: 1:30 sau 90.'; vm.start.focus(); return; }

      const value = normalizeVideo({
        id, start, size: vm.size.value, align: vm.align.value, ratio: vm.ratio.value, caption: vm.caption.value,
      });
      let index = vm.insertIndex;
      if (vm.editingBlot) {
        index = quill.getIndex(vm.editingBlot);
        quill.deleteText(index, 1, 'user');
      }
      quill.insertEmbed(index, 'youtube', value, 'user');
      quill.setSelection(index + 1, 0, 'silent');
      closeVideoDialog();
    }

    vm.url.addEventListener('input', () => {
      const id = refreshPreview();
      if (!id) return;
      // Pick sensible defaults from the pasted link (Shorts → vertical, ?t= → start time)
      if (/\/shorts\//.test(vm.url.value)) vm.ratio.value = '9-16';
      const t = urlStartTime(vm.url.value);
      if (t && !vm.start.value) vm.start.value = formatTime(t);
    });
    vm.size.addEventListener('change', syncAlign);
    vm.save.addEventListener('click', saveVideoDialog);
    vm.cancel.addEventListener('click', closeVideoDialog);
    vm.del.addEventListener('click', () => {
      if (!vm.editingBlot) return;
      quill.deleteText(quill.getIndex(vm.editingBlot), 1, 'user');
      closeVideoDialog();
    });
    vm.root.addEventListener('click', e => { if (e.target === vm.root) closeVideoDialog(); });
    vm.root.addEventListener('keydown', e => {
      if (e.key === 'Escape') { e.preventDefault(); closeVideoDialog(); }
      if (e.key === 'Enter' && e.target.tagName === 'INPUT') { e.preventDefault(); saveVideoDialog(); }
    });

    /* ── Quill setup ── */
    const quill = new Quill('#quill-editor', {
      theme: 'snow',
      placeholder: 'Scrie conținutul articolului...',
      modules: {
        toolbar: {
          container: [
            [{ header: [2, 3, false] }],
            ['bold', 'italic', 'underline'],
            [{ list: 'ordered' }, { list: 'bullet' }],
            ['link', 'blockquote', 'video'],
            ['clean'],
          ],
          handlers: { video: () => openVideoDialog(null) },
        },
      },
    });

    /* Populate editor with existing content */
    const existingContent = document.getElementById('f-content').value;
    if (existingContent) quill.root.innerHTML = upgradeLegacyVideos(existingContent);

    /* Click a video in the editor → open its settings */
    quill.root.addEventListener('click', e => {
      const fig = e.target.closest('figure.video-embed');
      if (!fig) return;
      const blot = Quill.find(fig);
      if (blot && blot instanceof YoutubeBlot) openVideoDialog(blot);
    });

    /* Auto-generate slug from title (new posts only) */
    const titleInput = document.getElementById('f-title');
    const slugInput  = document.getElementById('f-slug');
    if (titleInput && slugInput) {
      titleInput.addEventListener('input', () => {
        slugInput.value = titleInput.value
          .toLowerCase()
          .normalize('NFD').replace(/[̀-ͯ]/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      });
    }

    /* ── Cover image tabs ── */
    function switchCoverTab(tab, btn) {
      document.querySelectorAll('.cover-tab').forEach(t => t.classList.remove('is-active'));
      document.querySelectorAll('.cover-tab-panel').forEach(p => p.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.getElementById('cover-panel-' + tab).classList.add('is-active');
    }

    /* Upload from file */
    document.getElementById('f-image-file').addEventListener('change', async function() {
      if (!this.files[0]) return;
      const statusEl = document.getElementById('upload-status');
      statusEl.style.color = '';
      statusEl.textContent = 'Încărcare...';
      const fd = new FormData();
      fd.append('image', this.files[0]);
      try {
        const r = await fetch('/admin/posts/upload-image', { method: 'POST', body: fd });
        const data = await r.json();
        if (data.error) {
          statusEl.style.color = '#c0392b';
          statusEl.textContent = '✗ Eroare: ' + data.error;
          return;
        }
        document.getElementById('f-coverImage').value = data.url;
        const prev = document.getElementById('cover-preview');
        prev.src = data.url;
        prev.classList.add('is-visible');
        statusEl.style.color = '#27ae60';
        statusEl.textContent = '✓ Imagine încărcată cu succes';
      } catch(e) {
        statusEl.style.color = '#c0392b';
        statusEl.textContent = '✗ Eroare la încărcare: ' + e.message;
        console.error('Upload error:', e);
      }
    });

    /* ── Gallery upload ── */
    async function uploadGalleryFile(slot, file) {
      const statusEl = document.getElementById('gstatus-' + slot);
      statusEl.style.color = '';
      statusEl.textContent = 'Încărcare...';
      const fd = new FormData();
      fd.append('image', file);
      try {
        const r = await fetch('/admin/posts/upload-image', { method: 'POST', body: fd });
        const data = await r.json();
        if (data.error) {
          statusEl.style.color = '#c0392b';
          statusEl.textContent = '✗ ' + data.error;
          return;
        }
        document.getElementById('gval-' + slot).value = data.url;
        const thumb = document.getElementById('gthumb-' + slot);
        thumb.src = data.url;
        thumb.classList.add('is-visible');
        document.getElementById('gremove-' + slot).style.display = '';
        statusEl.style.color = '#27ae60';
        statusEl.textContent = '✓ Imaginea a fost încărcată';
      } catch(e) {
        statusEl.style.color = '#c0392b';
        statusEl.textContent = '✗ Eroare: ' + e.message;
      }
    }

    function removeGallery(slot) {
      document.getElementById('gval-' + slot).value = '';
      const thumb = document.getElementById('gthumb-' + slot);
      thumb.src = '';
      thumb.classList.remove('is-visible');
      document.getElementById('gremove-' + slot).style.display = 'none';
      document.getElementById('gfile-' + slot).value = '';
      const statusEl = document.getElementById('gstatus-' + slot);
      statusEl.textContent = '';
    }

    for (let i = 0; i < 3; i++) {
      document.getElementById('gfile-' + i).addEventListener('change', function() {
        if (this.files[0]) uploadGalleryFile(parseInt(this.dataset.slot), this.files[0]);
      });
    }

    /* Apply external URL */
    function applyImageUrl() {
      const url = document.getElementById('f-image-url').value.trim();
      if (!url) return;
      document.getElementById('f-coverImage').value = url;
      const prev = document.getElementById('cover-preview');
      prev.src = url;
      prev.classList.add('is-visible');
    }

    /* Serialize Quill HTML before submit */
    document.getElementById('postForm').addEventListener('submit', () => {
      document.getElementById('f-content').value = quill.root.innerHTML;
    });
  </script>
</body>
</html>
